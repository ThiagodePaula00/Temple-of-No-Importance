@baseUrl = http://localhost:3000
@adminName = Temple Admin
@adminEmail = admin@example.com
@adminPassword = Change-this-password-123
@accessToken = {{refreshSession.response.body.accessToken}}
@refreshToken = {{refreshSession.response.body.refreshToken}}
@postId = {{createPost.response.body.id}}
@postSlug = {{createPost.response.body.slug}}

### Check API health
GET {{baseUrl}}/health

### List published posts
GET {{baseUrl}}/posts

### Search published posts (searches post content)
GET {{baseUrl}}/posts?q=integrals

### Create the first account (the first account becomes an administrator)
POST {{baseUrl}}/auth/sign-up
Content-Type: application/json

{
  "name": "{{adminName}}",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Sign in
# @name signIn
POST {{baseUrl}}/auth/sign-in
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

# Rotate the access and refresh tokens
# Run this after signing in, then use the returned tokens for the requests below.
# Access tokens expire after 15 minutes; refresh tokens expire after 7 days and rotate on use.
# @name refreshSession
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{signIn.response.body.refreshToken}}"
}

### Get the current account
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

### Update the current account profile
PATCH {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "{{adminName}}",
  "email": "{{adminEmail}}"
}

### Change the current account password
# This revokes all active refresh sessions for the account.
PATCH {{baseUrl}}/auth/me/password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "{{adminPassword}}",
  "newPassword": "Change-this-password-456"
}

### List all posts, including drafts (administrator only)
GET {{baseUrl}}/posts/admin
Authorization: Bearer {{accessToken}}

### Get a post by ID, including drafts (administrator only)
GET {{baseUrl}}/posts/admin/{{postId}}
Authorization: Bearer {{accessToken}}

### Create a published post (administrator only)
# @name createPost
POST {{baseUrl}}/posts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "A first Temple post",
  "excerpt": "A short introduction to this post.",
  "content": "Write the post content in Markdown. Use ![Alt text](/api/uploads/IMAGE.webp) for an uploaded image.",
  "coverImageUrl": "https://example.com/cover.jpg",
  "published": true
}

### Create a draft post (administrator only)
POST {{baseUrl}}/posts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "A draft post",
  "excerpt": "A draft that is not publicly visible.",
  "content": "Draft content in Markdown.",
  "coverImageUrl": "",
  "published": false
}

### Get a published post by slug
GET {{baseUrl}}/posts/{{postSlug}}

### Update a post (administrator only)
PATCH {{baseUrl}}/posts/{{postId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "An updated Temple post",
  "excerpt": "An updated summary.",
  "content": "Updated Markdown content.",
  "coverImageUrl": "https://example.com/cover.jpg",
  "published": true
}

### Delete a post (administrator only)
DELETE {{baseUrl}}/posts/{{postId}}
Authorization: Bearer {{accessToken}}

### Upload an image (administrator only; JPG, PNG, or WEBP, up to 5 MB)
# Replace ./path/to/your-image.jpg with an image file on your machine.
# The backend resizes it to at most 1920 px wide, converts it to WEBP, and returns its URL.
# @name uploadImage
POST {{baseUrl}}/upload
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=-----TempleImageBoundary

-------TempleImageBoundary
Content-Disposition: form-data; name="file"; filename="your-image.jpg"
Content-Type: image/jpeg

< ./path/to/your-image.jpg
-------TempleImageBoundary--

### Serve an uploaded image
# Replace IMAGE.webp with the filename from the upload response.
GET {{baseUrl}}/uploads/IMAGE.webp

### Revoke a refresh token (sign out)
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Delete the current account
# Destructive: deletes the account and its refresh-token records. Existing posts and uploaded images are not removed automatically.
DELETE {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}
