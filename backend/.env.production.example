NODE_ENV=production
APP_PORT=3000
POSTGRES_DB=templeBlog
POSTGRES_USER=posts_app
POSTGRES_PASSWORD=Set-this-through-the-deployment-environment
JWT_SECRET_KEY=Set-a-random-secret-with-at-least-32-characters
CORS_ORIGINS=https://blog.example.com
# Set to the exact IP/CIDR seen by the API for the trusted reverse proxy.
TRUSTED_PROXIES=
RATE_LIMIT_MAX=120
RATE_LIMIT_TTL_MS=60000
TYPEORM_SYNCHRONIZE=false
